{
	"hosting": {
		"public": "out",
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
		"frameworksBackend": {
			"region": "us-east1"
		}
	},
	"functions": [
		{
			"source": "functions",
			"codebase": "default",
			"runtime": "nodejs18",
			"ignore": [
				"node_modules",
				".git",
				"firebase-debug.log",
				"firebase-debug.*.log",
				"*.local"
			]
		}
	]
}
